{
  "name": "dot-ai-ui",
  "version": "0.15.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "lint": "eslint .",
    "generate:api": "openapi-generator-cli generate -i http://localhost:8080/api/v1/openapi -g typescript-fetch -o src/api/generated --additional-properties=typescriptThreePlus=true,supportsES6=true",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:coverage": "COVERAGE=true playwright test",
    "test:coverage": "npm run coverage:clean && npm run test:unit:coverage && npm run test:e2e:coverage && npm run coverage:report && npm run coverage:check",
    "coverage:clean": "rm -rf coverage",
    "coverage:report": "node scripts/coverage-report.mjs",
    "coverage:check": "nyc check-coverage --temp-directory coverage/merged",
    "coverage:open": "open coverage/combined/index.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vfarcic/dot-ai-ui.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vfarcic/dot-ai-ui/issues"
  },
  "homepage": "https://github.com/vfarcic/dot-ai-ui#readme",
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "jszip": "^3.10.1",
    "mermaid": "^11.12.2",
    "prismjs": "^1.30.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "yaml": "^2.8.2"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "shell-quote": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@openapitools/openapi-generator-cli": "^2.27.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.1",
    "nyc": "^18.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^8.0.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.0"
  }
}
